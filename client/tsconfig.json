{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "types": ["node", "inquirer"],
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src", // Set root directory for TypeScript files
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true, // Enable incremental compilation
    "tsBuildInfoFile": "./.tsbuildinfo", // Save build information for incremental builds
    "isolatedModules": true // Ensure each file is independently transpiled
  }
}
